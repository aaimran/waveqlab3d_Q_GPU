 btp(1)%bqrs=2d0,2d0,2d0, btp(1)%rho_s_p=2.7d0,3.464d0,6d0,
 btp(1)%lqrs=1,1,1, btp(1)%rqrs=1,1,1,
 btp(1)%pml_lqrs=T,T,T, btp(1)%pml_rqrs=T,T,T, btp(1)%npml=6 /
&moment_list
 use_moment_tensor=T, order=4 /
!---begin:tensor_listU---
'Cos-Bell' -0.9d0 0.05d0 0d0 0d0 0d0 0d0 -10d0 0d0 0d0 0d0 0d0 0
